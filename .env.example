# Copy to .env (never commit .env). On Hostinger, set these in
# hPanel → your Node.js app → Environment variables instead.
#
# Create the database first in hPanel → Databases → MySQL Databases.

# Hostinger MySQL — app and DB on the same Hostinger account:
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"

# Must match the deployed domain:
NEXTAUTH_URL="https://calcbid.com"

# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
