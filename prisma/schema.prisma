// Prisma schema for CalcBid — MySQL/MariaDB (Hostinger)
//
// Tables:
//   User / Account / Session / VerificationToken — Auth.js (next-auth)
//   Customer, Quote, RateCard, BusinessProfile, Invoice — CalcBid product

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Auth.js models (required by @next-auth/prisma-adapter) ──────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   @db.VarChar(255)
  plan          String    @default("Free") @db.VarChar(20) // Free | Solo | Crew
  accounts      Account[]
  sessions      Session[]
  customers     Customer[]
  quotes        Quote[]
  rateCards     RateCard[]
  invoices      Invoice[]
  profile       BusinessProfile?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── CalcBid product models ──────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?   @db.Text
  quotes    Quote[]
  invoices  Invoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Quote {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  number     String
  status     String    @default("draft") // draft | sent | viewed | approved | declined
  items      Json // [{ desc, qty, price }]
  taxRate    Float     @default(0)
  discount   Float     @default(0)
  markupPct  Float     @default(0)
  source     Json? // { calc: "slab", inputs: {...} } — which calculator produced this quote
  notes      String?   @db.Text
  biz        Json? // { name, email, phone } — snapshot of business info at save time
  validDays  Int       @default(30)
  quoteDate  DateTime  @default(now())
  invoice    Invoice?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, number])
  @@index([userId, status])
}

// Per-user business profile for the /app section (branding + defaults).
model BusinessProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String?
  ownerName       String?
  phone           String?
  email           String?
  address         String?
  markupPct       Float   @default(0)
  taxPct          Float   @default(0)
  expiryDays      Int     @default(14)
  paymentTerms    Int     @default(14) // Net 7/14/30
  laborRate       Float   @default(0) // default $/sq ft
  trades          Json? // ["Concrete", "Painting", ...]
  nextQuoteNumber Int     @default(1001)
  nextInvoiceNumber Int   @default(1001)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Invoices converted from approved quotes (v1.5). One invoice per quote.
model Invoice {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quoteId   String    @unique
  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Customer? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  number    String
  items     Json // copied verbatim from the quote
  subtotal  Float     @default(0)
  discount  Float     @default(0)
  markupPct Float     @default(0)
  taxRate   Float     @default(0)
  total     Float     @default(0)
  issueDate DateTime  @default(now())
  dueDate   DateTime
  status    String    @default("unpaid") // unpaid | paid
  paidAt    DateTime?
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, number])
  @@index([userId, status])
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  trade       String // concrete | siding | hvac | ...
  city        String // boise-id (slug)
  cityLabel   String // "Boise, ID"
  details     String?  @db.Text
  contactTime String? // morning | afternoon | evening
  consentAt   DateTime // TCPA consent timestamp
  status      String   @default("new") // new | contacted | quoted | won | lost
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([trade, city, status])
}

model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String? // homepage | calculators | guides | ...
  trade     String? // optional trade the visitor asked for
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

model RateCard {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade  String // paint | roofing | tile | ...
  key    String // pricePerGallon | laborPerSquare | ...
  value  Float

  @@unique([userId, trade, key])
}
